{
  "name": "kinesphere",
  "private": true,
  "description": "Static web app: tests only (the app itself needs no build step)",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.mjs\" \"tests/browser/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "build:test-model": "bash ai-partner/make_test_model.sh"
  },
  "devDependencies": {
    "peer": "1.0.2",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
